    <string name="q_title">QUALITÄTSSTUFE</string>
    <string name="q_desc">Die Basisstufe des Spiels. Die Einstellungen darunter verfeinern einzelne Teile davon. Unten links im Spiel siehst du, welche Stufe aktiv ist.</string>
    <string name="scale_title">RENDER-SKALIERUNG</string>
    <string name="scale_desc">Anteil der Bildschirmauflösung, in dem die 3D-Szene gezeichnet wird. 1.0 ist am schärfsten, weniger gibt mehr FPS.</string>
    <string name="dist_title">SICHTWEITE</string>
    <string name="dist_desc">Wie weit du sehen kannst, in Prozent der Stufe. Weniger gibt mehr FPS.</string>
    <string name="opt_shadows">Schatten</string>
    <string name="opt_shadows_desc">Echtzeit-Schatten. Aus gibt mehr FPS.</string>
    <string name="opt_bloom">Bloom</string>
